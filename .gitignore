# Dependencies
node_modules/

# Build output — Vercel builds this fresh from source on every deploy,
# so committing it just bloats the repo and risks a stale dist/ shipping
# if someone forgets to rebuild before a manual commit.
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local

# Editor/OS
.DS_Store
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
